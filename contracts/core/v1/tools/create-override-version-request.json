{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/core/v1/tools/create-override-version-request.json",
  "title": "create_override_version request",
  "description": "Request schema for the 'create_override_version' tool. State-changing; creates a child version through the platform API with expected_revision and the derived idempotency key; never modifies the parent.",
  "x-finplan-checks": [
    "no_storage_locations",
    "domain_payload"
  ],
  "x-finplan-domain-payloads": [
    {
      "pointer": "/content",
      "kind": "plan_content"
    }
  ],
  "type": "object",
  "properties": {
    "plan_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/plan_id"
    },
    "parent_plan_version_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/plan_version_id"
    },
    "expected_revision": {
      "$ref": "https://contracts.finplan.invalid/core/v1/concurrency.json#/$defs/expected_revision"
    },
    "idempotency_key": {
      "$ref": "https://contracts.finplan.invalid/core/v1/idempotency.json#/$defs/idempotency_key"
    },
    "domain": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/domain"
    },
    "domain_schema_version": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/domain_schema_version"
    },
    "content": {
      "type": "object"
    },
    "reason": {
      "type": "string",
      "maxLength": 2000
    },
    "contract_version": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/contract_version"
    },
    "synthetic": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/synthetic"
    }
  },
  "required": [
    "plan_id",
    "parent_plan_version_id",
    "expected_revision",
    "idempotency_key",
    "domain",
    "domain_schema_version",
    "content"
  ],
  "additionalProperties": false
}
