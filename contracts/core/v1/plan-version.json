{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/core/v1/plan-version.json",
  "title": "Plan version",
  "description": "Immutable plan version with lineage. parent_plan_version_id is null only for a root; run_id is null for manual or Excel versions. An override is always a new child version; a no-effect override has a checksum equal to its parent's.",
  "x-finplan-checks": [
    "domain_payload"
  ],
  "x-finplan-domain-payloads": [
    {
      "pointer": "/content",
      "kind": "plan_content",
      "optional": true
    }
  ],
  "type": "object",
  "properties": {
    "plan_version_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/plan_version_id"
    },
    "plan_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/plan_id"
    },
    "parent_plan_version_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/plan_version_id_or_null"
    },
    "input_snapshot_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/input_snapshot_id"
    },
    "configuration_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/configuration_id"
    },
    "model_version": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/model_version"
    },
    "run_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/run_id_or_null"
    },
    "origin": {
      "$ref": "#/$defs/origin"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "checksum": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/checksum",
      "description": "SHA-256 of the RFC 8785 canonical content."
    },
    "domain": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/domain"
    },
    "domain_schema_version": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/domain_schema_version"
    },
    "content": {
      "type": "object",
      "description": "Domain payload (kind plan_content) validated by the domain adapter."
    },
    "content_ref": {
      "$ref": "https://contracts.finplan.invalid/core/v1/artifact-ref.json"
    },
    "source_artifact": {
      "$ref": "https://contracts.finplan.invalid/core/v1/artifact-ref.json"
    },
    "no_effect": {
      "type": "boolean"
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.finplan.invalid/core/v1/error.json"
      }
    },
    "created_at": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/timestamp"
    },
    "synthetic": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/synthetic"
    }
  },
  "required": [
    "plan_version_id",
    "plan_id",
    "parent_plan_version_id",
    "input_snapshot_id",
    "configuration_id",
    "model_version",
    "run_id",
    "origin",
    "status",
    "checksum",
    "domain",
    "domain_schema_version",
    "created_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "origin": {
            "const": "model_run"
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "properties": {
          "run_id": {
            "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/run_id"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "origin": {
            "enum": [
              "manual_override",
              "excel_import"
            ]
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "properties": {
          "run_id": {
            "type": "null"
          },
          "parent_plan_version_id": {
            "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/plan_version_id"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "origin": {
            "const": "excel_import"
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "required": [
          "source_artifact"
        ],
        "properties": {
          "source_artifact": {
            "properties": {
              "kind": {
                "const": "excel_source"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "validation_errors"
        ],
        "properties": {
          "validation_errors": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "origin": {
      "type": "string",
      "enum": [
        "model_run",
        "manual_override",
        "excel_import"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_validation",
        "validated",
        "invalid"
      ]
    }
  }
}
