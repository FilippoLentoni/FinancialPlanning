{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/core/v1/api/record-execution-request.json",
  "title": "Record execution request",
  "description": "Plan lifecycle API route schema (FinancialPlanning platform; added in contracts 0.2.0, design D13). Body of POST /v1/publications/{publication_id}/executions. publication_id equals the path parameter. Phase 1 modes are paper and simulated; any other mode, including live, fails with OPERATION_NOT_PERMITTED. Recording an execution never modifies the publication or plan version.",
  "x-finplan-checks": [
    "no_storage_locations"
  ],
  "type": "object",
  "properties": {
    "publication_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/publication_id"
    },
    "mode": {
      "$ref": "https://contracts.finplan.invalid/core/v1/execution.json#/properties/mode"
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    },
    "idempotency_key": {
      "$ref": "https://contracts.finplan.invalid/core/v1/idempotency.json#/$defs/idempotency_key"
    },
    "contract_version": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/contract_version"
    },
    "synthetic": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/synthetic"
    }
  },
  "required": [
    "publication_id",
    "mode",
    "idempotency_key"
  ],
  "additionalProperties": false
}
