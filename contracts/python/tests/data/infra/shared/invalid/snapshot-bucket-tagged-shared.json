{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Environment data (snapshots) in a shared resource (ENV-16).",
  "Metadata": {
    "synthetic": true
  },
  "Resources": {
    "SnapshotBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "Tags": [
          {
            "Key": "project",
            "Value": "finplan"
          },
          {
            "Key": "owner-repo",
            "Value": "financialplanning"
          },
          {
            "Key": "environment",
            "Value": "shared"
          },
          {
            "Key": "logical-role",
            "Value": "snapshot-artifact-bucket"
          }
        ]
      }
    }
  }
}
