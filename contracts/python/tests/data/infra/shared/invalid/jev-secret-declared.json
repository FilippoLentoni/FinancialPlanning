{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "IaC declaring the pre-existing Jev API key secret (ENV-16).",
  "Metadata": {
    "synthetic": true
  },
  "Resources": {
    "JevApiKey": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": "finplan/shared/financemodel/jev-api-key",
        "Tags": [
          {
            "Key": "project",
            "Value": "finplan"
          },
          {
            "Key": "owner-repo",
            "Value": "financemodel"
          },
          {
            "Key": "environment",
            "Value": "shared"
          },
          {
            "Key": "logical-role",
            "Value": "jev-api-key"
          }
        ]
      }
    }
  }
}
