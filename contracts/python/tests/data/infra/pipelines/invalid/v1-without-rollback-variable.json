          },
          {
            "Key": "logical-role",
            "Value": "pipeline-build-project"
          }
        ]
      }
    },
    "PipelineArtifactBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "Tags": [
          {
            "Key": "project",
            "Value": "finplan"
          },
          {
            "Key": "owner-repo",
            "Value": "financialplanning"
