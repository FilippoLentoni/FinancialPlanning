                "Service": "codepipeline.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "PermissionsBoundary": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/finplan-shared-permission-boundary"
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "finplan"
          },
          {
            "Key": "owner-repo",
            "Value": "financialplanning"
          },
          {
            "Key": "environment",
