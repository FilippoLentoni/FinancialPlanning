{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/finance/v1/snapshot-payload.json",
  "title": "Snapshot payload",
  "description": "Finance adapter snapshot payload (kind snapshot): instruments and observations. Market-data semantics live here, never in the envelope.",
  "type": "object",
  "properties": {
    "dataset_id": {
      "type": "string",
      "pattern": "^finance/[a-z0-9-]+/[A-Za-z0-9._-]+$"
    },
    "calendar": {
      "type": "string",
      "pattern": "^[A-Z]{4}$"
    },
    "instruments": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.finplan.invalid/finance/v1/instrument.json"
      },
      "minItems": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.finplan.invalid/finance/v1/observation.json"
      }
    },
    "synthetic": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/synthetic"
    },
    "universe": {
      "type": "object",
      "description": "Optional (added in 1.1.0): the research-universe block of a multi-instrument dataset (for example finance/equity-etf-daily/research-universe). Lists every instrument with its kind; cash appears only here with its return assumption and has no observations. adj_close is the declared return basis.",
      "properties": {
        "instruments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "instrument_id": {
                "$ref": "https://contracts.finplan.invalid/finance/v1/instrument.json#/$defs/instrument_id"
              },
              "kind": {
                "$ref": "https://contracts.finplan.invalid/finance/v1/instrument.json#/properties/kind"
              },
              "return_assumption": {
                "$ref": "https://contracts.finplan.invalid/finance/v1/instrument.json#/properties/return_assumption"
              }
            },
            "required": [
              "instrument_id",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "history_start": {
          "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/date"
        },
        "return_basis": {
          "type": "string",
          "enum": [
            "adj_close",
            "close"
          ]
        }
      },
      "required": [
        "instruments",
        "history_start",
        "return_basis"
      ],
      "additionalProperties": false
    },
    "bias_disclosures": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/bias_disclosures"
    }
  },
  "required": [
    "dataset_id",
    "instruments",
    "observations"
  ]
}
