{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/finance/v1/tools/run-recursive-improvement-request.json",
  "title": "tools/run-recursive-improvement-request",
  "type": "object",
  "x-finplan-checks": ["no_storage_locations"],
  "properties": {
    "cycle_id": {"$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/analysis_id"},
    "portfolio_id": {"$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/portfolio_id"},
    "query": {"type": "string", "minLength": 1, "maxLength": 2000},
    "feedback": {"type": "string", "minLength": 1, "maxLength": 4000},
    "dry_run": {"type": "boolean", "default": true},
    "confirmed_by_user": {"type": "boolean"},
    "max_iterations": {"type": "integer", "minimum": 1, "maximum": 3, "default": 3},
    "idempotency_key": {"$ref": "https://contracts.finplan.invalid/core/v1/idempotency.json#/$defs/idempotency_key"},
    "contract_version": {"$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/contract_version"},
    "synthetic": {"type": "boolean"}
  },
  "additionalProperties": false,
  "allOf": [{
    "if": {"properties": {"dry_run": {"const": false}}, "required": ["dry_run"]},
    "then": {
      "required": ["idempotency_key", "confirmed_by_user"],
      "properties": {"confirmed_by_user": {"const": true}}
    }
  }]
}
