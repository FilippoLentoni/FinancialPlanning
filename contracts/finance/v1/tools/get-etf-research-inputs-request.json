{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/finance/v1/tools/get-etf-research-inputs-request.json",
  "title": "tools/get-etf-research-inputs-request",
  "type": "object",
  "properties": {
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"
      }
    },
    "decision_at": {
      "type": "string",
      "format": "date-time"
    },
    "contract_version": {
      "type": "string"
    },
    "baseline_analysis_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/analysis_id"
    },
    "input_snapshot_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/input_snapshot_id"
    },
    "algorithm": {
      "enum": [
        "min_variance",
        "mean_variance",
        "cvar"
      ]
    }
  },
  "required": [
    "symbols"
  ],
  "additionalProperties": false
}
