{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/finance/v1/tools/get-etf-research-inputs-response.json",
  "title": "tools/get-etf-research-inputs-response",
  "type": "object",
  "properties": {
    "decision_at": {
      "type": "string",
      "format": "date-time"
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"
      }
    },
    "feature_protocol": {
      "type": "string"
    },
    "features": {
      "type": "object"
    },
    "models": {
      "type": "object"
    },
    "provenance": {
      "type": "array",
      "maxItems": 168,
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contract_version": {
      "type": "string"
    }
  },
  "required": [
    "decision_at",
    "symbols",
    "feature_protocol",
    "features",
    "models",
    "provenance",
    "limitations",
    "contract_version"
  ],
  "additionalProperties": false
}
