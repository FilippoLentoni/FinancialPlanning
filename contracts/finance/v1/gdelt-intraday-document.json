{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/finance/v1/gdelt-intraday-document.json",
  "title": "gdelt-intraday-document",
  "type": "object",
  "properties": {
    "aliases": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 9,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "string"
        }
      }
    },
    "disclosures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 20
    },
    "feature_version": {
      "const": "gdelt-gkg-v2-premarket-organization-tone-v1"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "properties": {
          "article_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cluster_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "instrument_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"
          },
          "missing": {
            "type": "boolean"
          },
          "tone": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "article_count",
          "cluster_count",
          "instrument_id",
          "missing",
          "tone"
        ],
        "additionalProperties": false
      }
    },
    "lineage": {
      "type": "object",
      "properties": {
        "attribution": {
          "type": "string"
        },
        "availability_basis": {
          "type": "string"
        },
        "platform_available_at": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "central_available_at": {
          "type": "string",
          "format": "date-time"
        },
        "rights": {
          "type": "object",
          "properties": {
            "attribution": {
              "type": "string"
            },
            "evidence_checksum": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "evidence_url": {
              "type": "string",
              "format": "uri"
            },
            "retrieved_at": {
              "type": "string",
              "format": "date-time"
            },
            "rights_status": {
              "const": "research_and_training"
            },
            "scope": {
              "const": "released_GDELT_machine_metadata_only"
            }
          },
          "required": [
            "attribution",
            "evidence_checksum",
            "evidence_url",
            "retrieved_at",
            "rights_status",
            "scope"
          ],
          "additionalProperties": false
        },
        "source": {
          "const": "gdelt-gkg-v2"
        },
        "source_available_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "archive_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "archive_checksum": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "batch_at": {
                "type": "string",
                "format": "date-time"
              },
              "retrieved_at": {
                "type": "string",
                "format": "date-time"
              },
              "source_available_at": {
                "type": "string",
                "format": "date-time"
              },
              "source_etag": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_last_modified": {
                "type": "string",
                "format": "date-time"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "archive_bytes",
              "archive_checksum",
              "batch_at",
              "retrieved_at",
              "source_available_at",
              "source_etag",
              "source_last_modified",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "attempts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "batch_at": {
                "type": "string",
                "format": "date-time"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "http_status": {
                "type": "integer",
                "minimum": 0,
                "maximum": 599
              },
              "retrieved_at": {
                "type": "string",
                "format": "date-time"
              },
              "archive_checksum": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "batch_at",
              "url",
              "http_status",
              "retrieved_at",
              "archive_checksum",
              "error"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "attribution",
        "availability_basis",
        "platform_available_at",
        "retrieved_at",
        "rights",
        "source",
        "source_available_at",
        "sources",
        "attempts"
      ],
      "additionalProperties": false
    },
    "rejected_rows": {
      "type": "integer",
      "minimum": 0
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_day": {
      "type": "string",
      "format": "date"
    },
    "synthetic": {
      "type": "boolean"
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "duplicate_documents": {
      "type": "integer",
      "minimum": 0
    },
    "unique_documents": {
      "type": "integer",
      "minimum": 0
    },
    "quality_status": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    },
    "expected_batches": {
      "const": 4
    },
    "captured_batches": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "missing_batches": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "required": [
    "aliases",
    "disclosures",
    "feature_version",
    "features",
    "lineage",
    "rejected_rows",
    "row_count",
    "source_day",
    "decision_cutoff",
    "window_start",
    "window_end",
    "duplicate_documents",
    "unique_documents",
    "quality_status",
    "expected_batches",
    "captured_batches",
    "missing_batches"
  ],
  "additionalProperties": false
}
