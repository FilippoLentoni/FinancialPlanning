{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/finance/v1/allocation.json",
  "title": "Allocation",
  "description": "Finance adapter: target weights per instrument plus optional cash weight.",
  "type": "object",
  "properties": {
    "weights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "instrument_id": {
            "$ref": "https://contracts.finplan.invalid/finance/v1/instrument.json#/$defs/instrument_id"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "instrument_id",
          "weight"
        ],
        "additionalProperties": false
      }
    },
    "cash_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "synthetic": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/synthetic"
    }
  },
  "required": [
    "weights"
  ]
}
