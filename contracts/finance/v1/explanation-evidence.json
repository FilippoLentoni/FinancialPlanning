{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/finance/v1/explanation-evidence.json",
  "title": "Explanation evidence",
  "description": "Finance adapter explanation evidence (kind explanation_evidence): deterministic numeric evidence reproducible from the referenced versions. Per-kind evidence schemas arrive in a later minor.",
  "type": "object",
  "properties": {
    "evidence_kind": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/vocabulary_value"
    },
    "subject": {
      "type": "object",
      "properties": {
        "plan_version_id": {
          "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/plan_version_id"
        },
        "compare_to_plan_version_id": {
          "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/plan_version_id_or_null"
        }
      },
      "required": [
        "plan_version_id"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "maxLength": 32
          }
        },
        "required": [
          "name",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.finplan.invalid/core/v1/artifact-ref.json"
      }
    },
    "synthetic": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/synthetic"
    }
  },
  "required": [
    "evidence_kind",
    "subject",
    "metrics"
  ]
}
