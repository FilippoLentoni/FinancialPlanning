{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/finance/v1/portfolio-decision.json",
  "title": "portfolio-decision",
  "type": "object",
  "properties": {
    "portfolio_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/portfolio_id"
    },
    "algorithm_family": {
      "enum": [
        "reinforcement_learning",
        "optimization",
        "language_model",
        "agentic",
        "control"
      ]
    },
    "algorithm": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "input_snapshot_id": {
      "anyOf": [
        {
          "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/input_snapshot_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "portfolio_revision": {
      "type": "integer",
      "minimum": 1
    },
    "recommendation": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "source_analysis_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/analysis_id"
    },
    "execution": {
      "type": "object",
      "properties": {
        "reference_date": {
          "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/date"
        },
        "reference_prices": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 100,
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "target_weights": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 101,
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "transaction_cost_bps": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "reference_date",
        "reference_prices",
        "target_weights",
        "transaction_cost_bps"
      ],
      "additionalProperties": false
    },
    "contract_version": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/contract_version"
    },
    "synthetic": {
      "type": "boolean"
    },
    "decision_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/decision_id"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected"
      ]
    },
    "created_at": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/timestamp"
    },
    "checksum": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/checksum"
    },
    "resolution": {
      "$ref": "https://contracts.finplan.invalid/finance/v1/api/resolve-portfolio-decision-response.json"
    },
    "automatic_experiment_policy": {
      "const": true
    },
    "run_id": {
      "type": "string"
    },
    "input_id": {
      "type": "string"
    },
    "native_input_ref": {
      "$ref": "https://contracts.finplan.invalid/finance/v1/native-input-ref.json"
    }
  },
  "required": [
    "decision_id",
    "portfolio_id",
    "algorithm_family",
    "algorithm",
    "input_snapshot_id",
    "portfolio_revision",
    "recommendation",
    "provenance",
    "execution",
    "status",
    "created_at",
    "checksum",
    "synthetic",
    "contract_version"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "native_input_ref"
        ]
      },
      "then": {
        "properties": {
          "input_snapshot_id": {
            "type": "null"
          },
          "automatic_experiment_policy": {
            "const": true
          },
          "synthetic": {
            "const": true
          }
        },
        "required": [
          "input_snapshot_id",
          "automatic_experiment_policy",
          "synthetic",
          "run_id",
          "input_id"
        ]
      },
      "else": {
        "properties": {
          "input_snapshot_id": {
            "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/input_snapshot_id"
          }
        }
      }
    }
  ]
}
