{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/finance/v1/api/resolve-portfolio-decision-response.json",
  "title": "api/resolve-portfolio-decision-response",
  "type": "object",
  "properties": {
    "decision_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/decision_id"
    },
    "portfolio_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/portfolio_id"
    },
    "action": {
      "enum": [
        "accept",
        "reject"
      ]
    },
    "status": {
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "before_revision": {
      "type": "integer",
      "minimum": 1
    },
    "after_revision": {
      "type": "integer",
      "minimum": 1
    },
    "paper_state": {
      "$ref": "https://contracts.finplan.invalid/finance/v1/paper-portfolio-state.json"
    },
    "simulated_fills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instrument_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "side": {
            "enum": [
              "buy",
              "sell"
            ]
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          },
          "reference_price": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "notional": {
            "type": "number",
            "minimum": 0
          },
          "transaction_cost": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "instrument_id",
          "side",
          "quantity",
          "reference_price",
          "notional",
          "transaction_cost"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "transaction_cost": {
      "type": "number",
      "minimum": 0
    },
    "paper_execution": {
      "type": "boolean"
    },
    "recorded_at": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/timestamp"
    },
    "reference_date": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/date"
    },
    "reference_prices": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100,
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "input_snapshot_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/input_snapshot_id"
    },
    "confirmed_by_user": {
      "const": true
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "checksum": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/checksum"
    },
    "execution_mode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reference_price_semantics": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "contract_version": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/contract_version"
    },
    "synthetic": {
      "type": "boolean"
    },
    "caller": {
      "type": "object"
    }
  },
  "required": [
    "decision_id",
    "portfolio_id",
    "action",
    "status",
    "before_revision",
    "after_revision",
    "paper_state",
    "simulated_fills",
    "transaction_cost",
    "paper_execution",
    "recorded_at",
    "reference_date",
    "input_snapshot_id",
    "confirmed_by_user",
    "synthetic",
    "contract_version"
  ],
  "additionalProperties": false
}
