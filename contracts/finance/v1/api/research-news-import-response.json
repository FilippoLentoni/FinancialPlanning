{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/finance/v1/api/research-news-import-response.json",
  "title": "api/research-news-import-response",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "provider": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"
          }
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "payload_checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "receipt_checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "rights": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "unverified",
                "research_only",
                "research_and_training",
                "denied"
              ]
            },
            "scope": {
              "enum": [
                "search_metadata",
                "full_content"
              ]
            },
            "evidence_url": {
              "type": "string",
              "maxLength": 2048
            },
            "evidence_checksum": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "scope",
            "evidence_url",
            "evidence_checksum"
          ],
          "additionalProperties": false
        },
        "quality_status": {
          "type": "string"
        },
        "eligible": {
          "type": "boolean"
        },
        "exclusion_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "records": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048
              },
              "published_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "symbols": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"
                }
              }
            },
            "required": [
              "title",
              "url",
              "published_at",
              "symbols"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "record_id",
        "provider",
        "query",
        "symbols",
        "retrieved_at",
        "available_at",
        "payload_checksum",
        "receipt_checksum",
        "rights",
        "quality_status",
        "eligible",
        "exclusion_reasons",
        "records"
      ],
      "additionalProperties": false
    },
    "contract_version": {
      "type": "string"
    }
  },
  "required": [
    "manifest",
    "contract_version"
  ],
  "additionalProperties": false
}
