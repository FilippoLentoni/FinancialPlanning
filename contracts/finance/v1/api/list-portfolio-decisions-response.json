{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/finance/v1/api/list-portfolio-decisions-response.json",
  "title": "api/list-portfolio-decisions-response",
  "type": "object",
  "properties": {
    "portfolio_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/portfolio_id"
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.finplan.invalid/finance/v1/portfolio-decision.json"
      },
      "maxItems": 100
    },
    "next_token": {
      "type": [
        "string",
        "null"
      ]
    },
    "contract_version": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/contract_version"
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "portfolio_id",
    "decisions",
    "next_token",
    "contract_version"
  ],
  "additionalProperties": false
}
