{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/finance/v1/api/gdelt-intraday-response.json",
  "title": "api/gdelt-intraday-response",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string"
    },
    "feature_version": {
      "const": "gdelt-gkg-v2-premarket-organization-tone-v1"
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"
      }
    },
    "decision_at": {
      "type": "string",
      "format": "date-time"
    },
    "availability_mode": {
      "enum": [
        "platform",
        "historical_source_proxy"
      ]
    },
    "coverage": {
      "type": "object",
      "properties": {
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "expected_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "captured_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "complete": {
          "type": "boolean"
        },
        "missing_days": {
          "type": "array",
          "maxItems": 31,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "required": [
        "start_date",
        "end_date",
        "expected_days",
        "captured_days",
        "complete",
        "missing_days"
      ],
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "maxItems": 31,
      "items": {
        "type": "object",
        "properties": {
          "checksum": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "document": {
            "allOf": [
              {
                "$ref": "https://contracts.finplan.invalid/finance/v1/gdelt-intraday-document.json"
              },
              {
                "properties": {
                  "lineage": {
                    "required": [
                      "central_available_at"
                    ]
                  }
                }
              }
            ]
          }
        },
        "required": [
          "checksum",
          "document"
        ],
        "additionalProperties": false
      }
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "contract_version",
    "feature_version",
    "symbols",
    "decision_at",
    "availability_mode",
    "coverage",
    "documents"
  ],
  "additionalProperties": false
}
