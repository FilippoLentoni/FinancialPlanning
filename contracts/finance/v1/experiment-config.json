{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.finplan.invalid/finance/v1/experiment-config.json",
  "title": "Experiment configuration",
  "description": "Finance adapter configuration payload (kind configuration), canonicalized for configuration_id.",
  "type": "object",
  "properties": {
    "strategy": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "objective": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "x-finplan-open-enum": true,
      "x-finplan-known-values": [
        "portfolio_optimization",
        "backtest",
        "forecast"
      ]
    },
    "universe": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.finplan.invalid/finance/v1/instrument.json#/$defs/instrument_id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "risk_aversion": {
      "type": "number",
      "minimum": 0
    },
    "lookback_days": {
      "type": "integer",
      "minimum": 1
    },
    "rebalance_frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "quarterly"
      ]
    },
    "constraints": {
      "$ref": "https://contracts.finplan.invalid/finance/v1/constraints.json"
    },
    "fees": {
      "$ref": "https://contracts.finplan.invalid/finance/v1/fees.json"
    },
    "synthetic": {
      "$ref": "https://contracts.finplan.invalid/core/v1/common.json#/$defs/synthetic"
    },
    "policy_source_run_id": {
      "$ref": "https://contracts.finplan.invalid/core/v1/identifiers.json#/$defs/run_id"
    },
    "policy_strategy_id": {
      "type": "string",
      "enum": ["ppo", "sac", "cash", "buy_and_hold", "equal_weight", "min_variance", "mean_variance", "scenario_cvar"]
    }
  },
  "required": [
    "strategy",
    "universe"
  ],
  "additionalProperties": false
}
